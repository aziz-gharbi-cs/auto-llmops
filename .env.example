# Application
ENVIRONMENT=local
DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/v1
SECRET_KEY=change-me-in-production-use-a-secure-random-32-byte-hex

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=llmops
POSTGRES_USER=llmops_user
POSTGRES_PASSWORD=llmops_secure_password
DATABASE_URL=postgresql+psycopg://llmops_user:llmops_secure_password@localhost:5432/llmops

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=docs_fastapi_pydantic_sqlalchemy
QDRANT_API_KEY=

# Object Storage (MinIO / S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=llmops-artifacts
S3_REGION=us-east-1

# Redis (Caching & Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=gemma3-documentation-assistant

# Prefect
PREFECT_API_URL=http://localhost:4200/api

# Inference Engine (Local Ollama / Production vLLM)
INFERENCE_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8000/v1
MODEL_NAME=gemma3:1b

# Embedding & Reranker Models
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL_NAME=BAAI/bge-reranker-base

# Observability (Prometheus & OTel)
PROMETHEUS_METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
